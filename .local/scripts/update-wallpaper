#!/usr/bin/env bash
# Expose the current Waypaper wallpaper at a fixed path so Hyprlock (and
# anything else) can reference a stable location.
#
# Waypaper invokes this as its `post_command` and passes the applied wallpaper
# via $wallpaper (spaces escaped). If no argument is given it falls back to
# reading `wallpaper =` from waypaper's config.ini. Either way, the chosen image
# is symlinked to $FIXED_PATH, keeping a single source of truth for Hyprlock.

set -euo pipefail

FIXED_PATH="${FIXED_PATH:-$HOME/.config/hypr/current_wallpaper}"
CONFIG_INI="${WAYPAPER_CONFIG:-$HOME/.config/waypaper/config.ini}"

# Optionally accept the wallpaper path as $1 (Waypaper passes it via $wallpaper,
# with spaces escaped as backslash-space). Otherwise extract the wallpaper path
# from waypaper's config.
if [[ -n "${1:-}" ]]; then
    WALL="${1//\\ / }"
else
    WALL="$(awk -F' *= *' '/^[[:space:]]*wallpaper[[:space:]]*=/{gsub(/^ +| +$/, "", $2); gsub(/^~/, ENVIRON["HOME"], $2); print $2; exit}' "$CONFIG_INI")"
fi

if [[ -z "$WALL" || ! -f "$WALL" ]]; then
    echo "update-wallpaper: no valid wallpaper found in $CONFIG_INI" >&2
    exit 1
fi

# Atomic symlink update
TMP="$FIXED_PATH.tmp.$$"
ln -sf "$WALL" "$TMP"
mv -f "$TMP" "$FIXED_PATH"

echo "update-wallpaper: linked $WALL -> $FIXED_PATH"
