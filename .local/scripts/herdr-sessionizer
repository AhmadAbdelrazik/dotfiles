#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find ~/projects ~/work ~/ ~/.config ~/.local -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
  exit 0
fi

selected=$(realpath "$selected")
selected_name=$(basename "$selected" | tr . _)

server_running=$(herdr status server --json 2>/dev/null | jq -e '.status == "running"' >/dev/null 2>&1 && echo yes || echo no)

if [[ -z $HERDR_ENV ]] && [[ $server_running == no ]]; then
  herdr server >/dev/null 2>&1 &
  disown
  for _ in {1..100}; do
    server_running=$(herdr status server --json 2>/dev/null | jq -e '.status == "running"' >/dev/null 2>&1 && echo yes || echo no)
    [[ $server_running == yes ]] && break
    sleep 0.1
  done
fi

ws=$(herdr pane list 2>/dev/null | jq -r --arg d "$selected" '[.result.panes[] | select(.cwd == $d) | .workspace_id][0] // empty' 2>/dev/null)

if [[ -z $ws ]]; then
  ws=$(herdr workspace create --cwd "$selected" --label "$selected_name" --no-focus 2>/dev/null | jq -r '.result.workspace.workspace_id // empty' 2>/dev/null)
fi

if [[ -z $ws ]]; then
  echo "herdr-sessionizer: could not open a herdr workspace for $selected" >&2
  exit 1
fi

herdr workspace focus "$ws" >/dev/null 2>&1

if [[ -z $HERDR_ENV ]]; then
  exec herdr
fi