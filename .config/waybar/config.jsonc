{
  "layer": "top",
  "height": 42,
  "spacing": 6,
  "include": [
    "./modules/*.jsonc",
  ],
  "modules-left": [
    "group/distro-group",
    "group/storage",
    "group/system",
    "hyprland/language"
  ],
  "modules-center": [
    "power-profiles-daemon",
    "hyprland/workspaces",
    "idle_inhibitor"
  ],
  "modules-right": [
    "group/audio",
    "group/brightness",
    "group/connections",
    "battery",
    "clock",
    "group/tray-group"
  ]
}
